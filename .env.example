# Aurora International - Environment Variables

# Contact form email (SMTP)
# Required to deliver messages from /contact directly to contact@auroraint.org
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional
# If omitted, defaults to true when SMTP_PORT=465, otherwise false
SMTP_SECURE=

# If omitted, defaults to SMTP_USER
SMTP_FROM=

# If omitted, defaults to contact@auroraint.org
CONTACT_TO=
